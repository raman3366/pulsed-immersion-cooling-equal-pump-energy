# text files: LF line endings
*.py        text eol=lf
*.sh        text eol=lf
*.md        text eol=lf
*.csv       text eol=lf
*.json      text eol=lf
*.yaml      text eol=lf
*.cff       text eol=lf
LICENSE*    text eol=lf
# compressed archives and time series: binary, no diff
*.tar.xz    binary
*.csv.gz    binary
*.pdf       binary
